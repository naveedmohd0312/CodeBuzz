SECRET_KEY=
DATABASE_URL=sqlite:///codebuzz.db
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
MAX_CONTENT_LENGTH=10485760
UPLOAD_DIR=

# Existing portfolio / unrelated AI configuration. Keep credentials server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=

# MCQ assessment provider configuration.
MCQ_API_KEY=
MCQ_MODEL=
MCQ_API_BASE_URL=https://api.featherless.ai/v1

# Coding assessment has its own Featherless client/configuration.
# If these are blank, it falls back to the shared Featherless variables below.
CODING_API_KEY=
CODING_MODEL=
CODING_API_BASE_URL=https://api.featherless.ai/v1

# Project interview has its own Featherless client/configuration.
# If these are blank, it falls back to the shared Featherless variables below.
PROJECT_API_KEY=
PROJECT_MODEL=
PROJECT_API_BASE_URL=https://api.featherless.ai/v1

# Shared Featherless fallback for assessment providers (backend only).
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Isolated Judge0 service (configure language IDs from that instance's /languages endpoint).
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
JUDGE0_ALLOW_HTTP=false
JUDGE0_LANGUAGES={}
CODING_PASS_PERCENT=70
CODE_RUN_TOTAL_TIMEOUT_SECONDS=60

# Configurable normalized weights for centralized pipeline performance.
PERFORMANCE_SCORE_WEIGHTS={"mcq":0.30,"coding":0.40,"project":0.30}
PROJECT_INTERVIEW_QUESTION_COUNT=6
PROJECT_INTERVIEW_INCREASE_AT=80
PROJECT_INTERVIEW_DECREASE_BELOW=50

# Optional SMTP configuration.
EMAIL_OTP_ENABLED=false
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_USE_TLS=true
OTP_RESEND_COOLDOWN=60
